</div>
<ProviderList Providers="@Store.Providers.Where(p=>DemoStore.Confirmation(p)!="Confirmación reciente")" /> }
    }
}
@code {
    [Parameter] public string? Id { get; set; }
    [SupplyParameterFromQuery(Name="estado")] public string? Estado { get; set; }
    private string Path => new Uri(Nav.Uri).AbsolutePath.Trim('/');
    private bool IsAdmin => Path.StartsWith("admin");
    private ProviderView edited = new();
    private string lastPath = "";
    private MudForm? form;
    private string search="", municipalityFilter="todos", typeFilter="todos", requestFilter="todos", response="";
    private bool confirmOperation;
    private readonly string[] types=["person","organization","community_center"], municipalities=["San Juan","Ponce","Mayagüez"], operationStates=["operational","limited","unavailable","unknown"], utilityStates=["available","unavailable","unknown"], availabilityStates=["available","limited","unavailable","unknown"], requestStates=["submitted","acknowledged","confirmed","declined","completed","cancelled"];
    private IEnumerable<RequestView> ProviderRequests => Store.Requests.Where(r=>r.FacilityId==Store.SelectedId);
    private IEnumerable<ProviderView> FilteredProviders => Store.Providers.Where(p=>(municipalityFilter=="todos" || p.Municipality==municipalityFilter) && (typeFilter=="todos" || p.ProviderType==typeFilter) && p.Name.Contains(search,StringComparison.OrdinalIgnoreCase));
    private IEnumerable<RequestView> FilteredRequests => (IsAdmin ? Store.Requests.Where(r=>r.Status is "submitted" or "acknowledged") : ProviderRequests).Where(r=>(requestFilter=="todos" || r.Status==requestFilter) && (r.Id+" "+r.Description).Contains(search,StringComparison.OrdinalIgnoreCase));
    private RequestView? CurrentRequest => (IsAdmin ? Store.Requests : ProviderRequests).FirstOrDefault(r=>r.Id==Id);
    private string Title => Path switch { "acceso"=>"Bienvenido a Pulso PR", "seleccionar"=>"Elige tu espacio de ayuda", "proveedor/perfil"=>"Perfil y horario", "proveedor/operacion"=>"Operación y confirmación", "proveedor/servicios"=>"Servicios que ofreces", "proveedor/recursos"=>"Disponibilidad de recursos", "proveedor/solicitudes"=>"Bandeja de solicitudes", "proveedor/historia"=>"Historia de actividad", "catalogo"=>"Directorio de ayuda", "admin"=>"Panorama territorial", "admin/proveedores"=>"Red de proveedores", "admin/pendientes"=>"Solicitudes pendientes", "admin/indicadores"=>"Indicadores de la demo", _ when Path.Contains("/solicitudes/")=>"Detalle de solicitud", _ when Path.StartsWith("catalogo/")=>"Detalle del proveedor", _=>"Hola, qué bueno tenerte aquí." };
    private string Category => IsAdmin ? "ADMINISTRACIÓN · DEMOSTRACIÓN" : Path.StartsWith("catalogo") ? "NUESTRA COMUNIDAD" : "PROVEEDOR · DEMOSTRACIÓN";
    private string Subtitle => Path switch { "admin"=>"Una visión de la ayuda disponible y las necesidades por coordinar.", "catalogo" or "admin/proveedores"=>"Personas, organizaciones y centros comunitarios que conectan ayuda.", "proveedor/solicitudes" or "admin/pendientes"=>"Revisa necesidades no urgentes y coordina el siguiente paso.", _=>"Información clara para una comunidad mejor conectada." };
    private string StateTitle => Estado switch { "error"=>"No pudimos cargar la información", "sin-acceso"=>"No tienes un proveedor asignado", "sesion"=>"Tu sesión ha vencido", _=>"Todavía no hay información" };
    private string StateDescription => Estado switch { "error"=>"Revisa la conexión y vuelve a intentar. No se guardaron cambios.", "sin-acceso"=>"Solicita una asignación al responsable del portal. Este estado es simulado.", "sesion"=>"Vuelve al acceso demo para continuar. No se muestran datos en este estado.", _=>"Cuando haya información para esta vista, la encontrarás aquí." };
    private string StateIcon => Estado switch { "error"=>Icons.Material.Outlined.CloudOff, "sin-acceso"=>Icons.Material.Outlined.Lock, "sesion"=>Icons.Material.Outlined.Login, _=>Icons.Material.Outlined.Inbox };
    protected override void OnInitialized() => Nav.LocationChanged += LocationChanged;
    protected override void OnParametersSet() => LoadView();
    private void LoadView() { if(lastPath!=Path) { search=""; municipalityFilter=typeFilter=requestFilter="todos"; lastPath=Path; } edited=Store.Selected.Copy(); response=""; confirmOperation=false; if(IsAdmin) Store.Role="admin"; else if(Path.StartsWith("proveedor")) Store.Role="proveedor"; }
    // Multiple routes share this component. Exact paths can change without any
    // route parameters changing, so navigation must explicitly refresh the view.
    private void LocationChanged(object? sender, LocationChangedEventArgs e) => _=InvokeAsync(() => { LoadView(); StateHasChanged(); });
    public void Dispose() => Nav.LocationChanged -= LocationChanged;
    private void Enter(bool admin) { Store.Role=admin ? "admin" : "proveedor"; Nav.NavigateTo(admin ? "/admin" : "/seleccionar"); }
    private void SelectProvider(string id) { Store.SelectedId=id; Store.Role="proveedor"; Nav.NavigateTo("/proveedor"); }
    private void ResetState() => Nav.NavigateTo(Estado=="sesion" ? "/acceso" : Nav.GetUriWithQueryParameter("estado",(string?)null));
    private void ClearFilters() { search=""; municipalityFilter=typeFilter="todos"; }
    private void CancelEdit() { edited=Store.Selected.Copy(); confirmOperation=false; Snackbar.Add("Cambios descartados.",Severity.Info); }
    private void SetAvailability(string value) { if(Path.EndsWith("servicios")) edited.ServiceAvailability=value; else edited.ResourceAvailability=value; }
    private void SetAvailabilityNote(string value) { if(Path.EndsWith("servicios")) edited.ServiceNote=value; else edited.ResourceNote=value; }
    private async Task SaveProvider() { if(Estado=="conflicto") return; if(form is not null) { await form.ValidateAsync(); if(!form.IsValid) return; } Store.Save(edited); Snackbar.Add("Cambio simulado guardado en memoria. Sin publicación real.",Severity.Success); }
    private async Task ConfirmOperation() { if(!confirmOperation) return; if(!string.IsNullOrEmpty(edited.InterruptionEnd) && (string.IsNullOrEmpty(edited.InterruptionStart) || string.CompareOrdinal(edited.InterruptionEnd,edited.InterruptionStart)<0)) { Snackbar.Add("Revisa el inicio y fin de la interrupción.",Severity.Warning); return; } edited.ConfirmedAt=DateTimeOffset.UtcNow; edited.Source="FacilityConfirmed"; await SaveProvider(); }
    private async Task Respond(string status) { if(Estado=="conflicto" || IsAdmin || CurrentRequest is not {} request) return; if(form is not null) { await form.ValidateAsync(); if(!form.IsValid) return; } if(string.IsNullOrWhiteSpace(response)) return; var allowed=request.Status switch { "submitted"=>status=="acknowledged", "acknowledged"=>status is "confirmed" or "declined", "confirmed"=>status=="completed", _=>false }; if(!allowed) return; request.Status=status; request.Events.Add((status,DateTimeOffset.UtcNow,response.Trim())); response=""; Snackbar.Add("Respuesta simulada. No se envió a ningún ciudadano.",Severity.Success); }
    private static string Optional(string value) => string.IsNullOrWhiteSpace(value) ? "No reportado" : value;
}
