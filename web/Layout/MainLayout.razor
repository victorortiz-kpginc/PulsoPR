@inherits LayoutComponentBase
@implements IDisposable
@inject DemoStore Store
@inject NavigationManager Nav
@inject PulsoPR.Web.Models.AppwritePortalApi Api
@inject PulsoPR.Web.Models.PortalAuthState Auth
<MudThemeProvider Theme="@theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
@if (!Auth.Ready)
{
    <main class="state-panel" role="status">Verificando tu sesión…</main>
}
else if (!IsAccessPage && !Auth.CanView(CurrentPath))
{
    <main class="state-panel" role="status">Abriendo el espacio de trabajo asignado…</main>
}
else
{
<a class="skip-link" href="#contenido">Saltar al contenido</a>
<div class="app-shell @(IsAccessPage ? "access-shell" : "")">
    @if (!IsAccessPage)
    {
    <aside class="sidebar @(menuOpen ? "is-open" : "")" aria-label="Navegación principal">
        <a class="brand" href="/" aria-label="Pulso PR inicio"><img class="brand-mark" src="brand/pulsopr-logo-horizontal.svg" alt="Pulso PR" /><small>Conectamos ayuda</small></a>
        <div class="sidebar-section">ESPACIO DE TRABAJO</div>
        <MudNavMenu Class="portal-nav">
            @if (Store.Role == "admin")
            {
                <MudNavLink Href="/admin" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Dashboard">Panorama territorial</MudNavLink>
                <MudNavLink Href="/admin/proveedores" Icon="@Icons.Material.Outlined.Groups">Proveedores</MudNavLink>
                <MudNavLink Href="/admin/pendientes" Icon="@Icons.Material.Outlined.Inbox">Pendientes</MudNavLink>
                <MudNavLink Href="/admin/indicadores" Icon="@Icons.Material.Outlined.BarChart">Indicadores</MudNavLink>
            }
            else
            {
                <MudNavLink Href="/proveedor" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Dashboard">Mi resumen</MudNavLink>
                <MudNavLink Href="/proveedor/perfil" Icon="@Icons.Material.Outlined.Storefront">Perfil y horario</MudNavLink>
                <MudNavLink Href="/proveedor/operacion" Icon="@Icons.Material.Outlined.RadioButtonChecked">Operación</MudNavLink>
                <MudNavLink Href="/proveedor/servicios" Icon="@Icons.Material.Outlined.MedicalServices">Servicios</MudNavLink>
                <MudNavLink Href="/proveedor/recursos" Icon="@Icons.Material.Outlined.Inventory2">Recursos</MudNavLink>
                <MudNavLink Href="/proveedor/solicitudes" Icon="@Icons.Material.Outlined.Inbox">Solicitudes</MudNavLink>
                <MudNavLink Href="/proveedor/historia" Icon="@Icons.Material.Outlined.History">Historia</MudNavLink>
            }
        </MudNavMenu>
        <div class="sidebar-section">COMUNIDAD</div>
        <MudNavMenu Class="portal-nav"><MudNavLink Href="/catalogo" Icon="@Icons.Material.Outlined.Explore">Directorio de ayuda</MudNavLink></MudNavMenu>
        <MudNavMenu Class="portal-nav"><MudNavLink Href="/mapa" Icon="@Icons.Material.Outlined.Map">Mapa comunitario</MudNavLink></MudNavMenu>
        <div class="sidebar-bottom"><div class="demo-note"><span class="demo-dot"></span> Información comunitaria</div><p>Información reportada.<br />Coordina antes de acudir.</p><MudButton Href="/acceso" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Logout">Cambiar perfil</MudButton></div>
    </aside>
    @if (menuOpen) { <button class="menu-scrim" aria-label="Cerrar navegación" @onclick="()=>menuOpen=false"></button> }
    }
    <div class="workspace">
        @if (!IsAccessPage)
        {
        <header class="topbar">
            <MudIconButton Class="menu-toggle" Icon="@Icons.Material.Outlined.Menu" aria-label="Abrir navegación" OnClick="()=>menuOpen=!menuOpen" />
            <div class="topbar-context">Portal de ayuda <span>/</span> <strong>@(Store.Role == "admin" ? "Administración" : "Proveedor")</strong></div>
            <div class="topbar-actions"><span class="review-label">Puerto Rico · Comunidad</span><span class="avatar">@(Store.Role == "admin" ? "AD" : "PR")</span><MudButton Size="Size.Small" OnClick="LogoutAsync">Cerrar sesión</MudButton></div>
        </header>
        }
        <main id="contenido" tabindex="-1">@Body</main>
        <footer class="app-footer"><span>Pulso PR · Una comunidad, más posibilidades.</span><span>Hora de Puerto Rico</span></footer>
    </div>
</div>
}
@code {
    private bool menuOpen;
    private bool IsAccessPage => new Uri(Nav.Uri).AbsolutePath.TrimEnd('/') is "/acceso" or "/recuperacion";
    private readonly MudTheme theme = new()
    {
        PaletteLight = new PaletteLight { Primary="#075989", PrimaryDarken="#064669", PrimaryLighten="#E8F3F8", Secondary="#FF584D", Background="#F5F8FA", Surface="#FFFFFF", TextPrimary="#173044", TextSecondary="#687985", LinesDefault="#DCE7EC", Success="#176A55", Warning="#936427", Error="#B95549", Info="#075989" },
        LayoutProperties = new LayoutProperties { DefaultBorderRadius="12px" },
        Typography = new Typography { Default = new DefaultTypography { FontFamily=["Inter", "ui-sans-serif", "system-ui", "-apple-system", "Segoe UI", "sans-serif"] } }
    };
    private string CurrentPath => new Uri(Nav.Uri).AbsolutePath.Trim('/');
    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += LocationChanged;
        try { Auth.Set(await Api.CurrentSessionAsync()); } catch { Auth.Set(null); }
        ApplyRoute();
    }
    private void ApplyRoute()
    {
        var path = CurrentPath;
        if (IsAccessPage)
        {
            if (Auth.Session?.Role is "provider" or "admin") Nav.NavigateTo(Auth.Session.Role == "admin" ? "/admin" : "/proveedor", replace: true);
            return;
        }
        if (Auth.Session?.Role is not ("provider" or "admin")) { Nav.NavigateTo("/acceso", replace: true); return; }
        if (path.Length == 0) { Nav.NavigateTo(Auth.Session.Role == "admin" ? "/admin" : "/proveedor", replace: true); return; }
        if (Auth.Session.Role == "provider" && path.StartsWith("admin", StringComparison.Ordinal)) { Nav.NavigateTo("/proveedor", replace: true); return; }
        if (Auth.Session.Role == "admin" && path.StartsWith("proveedor", StringComparison.Ordinal)) { Nav.NavigateTo("/admin", replace: true); return; }
        Store.Role = Auth.Session.Role;
    }
    private void LocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) { menuOpen=false; ApplyRoute(); _=InvokeAsync(StateHasChanged); }
    private async Task LogoutAsync()
    {
        try { await Api.SignOutAsync(); } finally { Auth.Clear(); Store.SetLoading(); Nav.NavigateTo("/acceso", replace: true); }
    }
    public void Dispose() => Nav.LocationChanged -= LocationChanged;
}
